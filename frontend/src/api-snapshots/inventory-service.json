{
  "components": {
    "schemas": {
      "InventoryCreateRequest": {
        "properties": {
          "availableQuantity": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "productId": {
            "format": "uuid",
            "type": "string"
          },
          "warehouseId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "productId",
          "warehouseId"
        ],
        "type": "object"
      },
      "InventoryResponse": {
        "properties": {
          "availableQuantity": {
            "format": "int32",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "productId": {
            "format": "uuid",
            "type": "string"
          },
          "reservedQuantity": {
            "format": "int32",
            "type": "integer"
          },
          "warehouseId": {
            "format": "uuid",
            "type": "string"
          },
          "warehouseName": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "InventorySummaryResponse": {
        "properties": {
          "productId": {
            "format": "uuid",
            "type": "string"
          },
          "totalAvailable": {
            "format": "int32",
            "type": "integer"
          },
          "totalReserved": {
            "format": "int32",
            "type": "integer"
          },
          "warehouses": {
            "items": {
              "$ref": "#/components/schemas/InventoryResponse"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ReservationLookupRequest": {
        "properties": {
          "orderId": {
            "format": "uuid",
            "type": "string"
          },
          "productId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "productId"
        ],
        "type": "object"
      },
      "ReservationResponse": {
        "properties": {
          "orderId": {
            "format": "uuid",
            "type": "string"
          },
          "productId": {
            "format": "uuid",
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "type": "integer"
          },
          "reservationId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "RESERVED",
              "RELEASED",
              "DEDUCTED"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ReserveRequest": {
        "properties": {
          "orderId": {
            "format": "uuid",
            "type": "string"
          },
          "productId": {
            "format": "uuid",
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "orderId",
          "productId"
        ],
        "type": "object"
      },
      "WarehouseRequest": {
        "properties": {
          "location": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "location",
          "name"
        ],
        "type": "object"
      },
      "WarehouseResponse": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "An RS256 access token from POST /api/v1/auth/login, verified against user-service's published JWKS (ADR 007). Paste the token value only, without the \"Bearer \" prefix -- Swagger UI adds it.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Warehouse stock, reservation, release, and deduction",
    "title": "Inventory Service API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/inventory": {
      "post": {
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Inventory"
        ]
      }
    },
    "/api/v1/inventory/deduct": {
      "post": {
        "operationId": "deduct",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationLookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Inventory"
        ]
      }
    },
    "/api/v1/inventory/release": {
      "post": {
        "operationId": "release",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationLookupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Inventory"
        ]
      }
    },
    "/api/v1/inventory/reserve": {
      "post": {
        "operationId": "reserve",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Inventory"
        ]
      }
    },
    "/api/v1/inventory/{productId}": {
      "get": {
        "operationId": "getSummary",
        "parameters": [
          {
            "in": "path",
            "name": "productId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/InventorySummaryResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Inventory"
        ]
      }
    },
    "/api/v1/warehouses": {
      "get": {
        "operationId": "list",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WarehouseResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Warehouses"
        ]
      },
      "post": {
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WarehouseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/WarehouseResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Warehouses"
        ]
      }
    },
    "/api/v1/warehouses/{id}": {
      "get": {
        "operationId": "getById",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/WarehouseResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Warehouses"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "description": "Warehouse management (ADMIN / WAREHOUSE_MANAGER only)",
      "name": "Warehouses"
    },
    {
      "description": "Warehouse stock and reservation lifecycle",
      "name": "Inventory"
    }
  ]
}
