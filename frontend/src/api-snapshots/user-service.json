          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
    "/api/v1/auth/service-token": {
      "post": {
        "description": "Exchanges a service's client id and secret for a short-lived SERVICE-role JWT",
        "operationId": "serviceToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceTokenResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Issue a service token",
        "tags": [
          "Auth"
        ]
      }
    },
