{
  "components": {
    "schemas": {
      "ChargeRequest": {
        "properties": {
          "amount": {
            "minimum": 0,
            "type": "number"
          },
          "currency": {
            "pattern": "[A-Z]{3}",
            "type": "string"
          },
          "orderId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "orderId"
        ],
        "type": "object"
      },
      "PaymentResponse": {
        "properties": {
          "amount": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "orderId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "SUCCESS",
              "FAILED",
              "REFUNDED"
            ],
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RefundRequest": {
        "properties": {
          "orderId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "orderId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "An RS256 access token from POST /api/v1/auth/login, verified against user-service's published JWKS (ADR 007). Paste the token value only, without the \"Bearer \" prefix -- Swagger UI adds it.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Mock payment processing",
    "title": "Payment Service API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/payments": {
      "post": {
        "operationId": "charge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChargeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Payments"
        ]
      }
    },
    "/api/v1/payments/order/{orderId}": {
      "get": {
        "operationId": "getByOrderId",
        "parameters": [
          {
            "in": "path",
            "name": "orderId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Payments"
        ]
      }
    },
    "/api/v1/payments/refund": {
      "post": {
        "operationId": "refund",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefundRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Payments"
        ]
      }
    },
    "/api/v1/payments/{id}": {
      "get": {
        "operationId": "getById",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "Payments"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "description": "Mock payment processing (ADMIN / SERVICE only)",
      "name": "Payments"
    }
  ]
}
