{
  "components": {
    "schemas": {
      "AgentResponse": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "AssignDeliveryRequest": {
        "properties": {
          "agentId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "agentId"
        ],
        "type": "object"
      },
      "CreateAgentRequest": {
        "properties": {
          "name": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "phone": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "name",
          "phone",
          "userId"
        ],
        "type": "object"
      },
      "DeliveryResponse": {
        "properties": {
          "agentId": {
            "format": "uuid",
            "type": "string"
          },
          "assignedAt": {
            "format": "date-time",
            "type": "string"
          },
          "deliveredAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "shipmentId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "ASSIGNED",
              "COMPLETED"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ShipmentResponse": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "orderId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "CREATED",
              "ASSIGNED",
              "DELIVERED"
            ],
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "An RS256 access token from POST /api/v1/auth/login, verified against user-service's published JWKS (ADR 007). Paste the token value only, without the \"Bearer \" prefix -- Swagger UI adds it.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
