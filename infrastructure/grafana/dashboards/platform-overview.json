{
  "title": "Smart Delivery Platform - Overview",
  "uid": "sdp-platform-overview",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["smart-delivery-platform"],
  "panels": [
    {
      "id": 1,
      "title": "Request rate per service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate per service (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (job) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 request latency per service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Order processing outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(order_saga_outcomes_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "description": "Rate of order sagas reaching a terminal outcome (delivered/cancelled/failed) -- see OrderSagaEventHandler and OrderService#cancel."
    },
    {
      "id": 5,
      "title": "Order failure rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(order_saga_outcomes_total{outcome=\"failed\"}[15m])) / sum(rate(order_saga_outcomes_total[15m]))",
          "legendFormat": "failure rate"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM heap used per service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "GC pause time per service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (rate(jvm_gc_pause_seconds_sum[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "DB connection pool saturation (HikariCP)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (hikaricp_connections_active) / sum by (job) (hikaricp_connections_max)",
          "legendFormat": "{{job}}"
        }
      ],
      "description": "Only meaningful for the 6 services with a database (user, product, inventory, order, payment, delivery) -- api-gateway and notification-service have no pool and report no series here."
    },
    {
      "id": 9,
      "title": "Outbox backlog per service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (outbox_pending_count)",
          "legendFormat": "{{job}}"
        }
      ],
      "description": "Rows committed but not yet on Kafka, per service (ADR 006). A small, constantly-changing number is the healthy steady state -- rows land and drain within one poll interval. A number that only climbs means publishing is stuck, which from downstream is indistinguishable from a stalled saga."
    },
    {
      "id": 10,
      "title": "Oldest unpublished outbox event",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (job) (outbox_oldest_pending_age_seconds)",
          "legendFormat": "{{job}}"
        }
      ],
      "description": "Age of the oldest PENDING row (ADR 006). This is the alertable outbox signal: it should sit near the 2s poll interval. Anything sustained above a few seconds means events are committed but not reaching consumers."
    },
    {
      "id": 11,
      "title": "Outbox publish rate by event type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, eventType) (rate(outbox_published_total[5m]))",
          "legendFormat": "{{job}} {{eventType}}"
        }
      ],
      "description": "Events actually handed to Kafka by OutboxPublisher, tagged by event type."
    },
    {
      "id": 12,
      "title": "Outbox publish failures by event type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, eventType) (rate(outbox_publish_failures_total[5m]))",
          "legendFormat": "{{job}} {{eventType}}"
        }
      ],
      "description": "Failed sends (ADR 006). A failure deliberately holds back the rest of that aggregate's events, so failures confined to one event type mean a stalled stream for those aggregates, not merely a retry. Retries back off exponentially, so this rate falls away even while the backlog panel above does not."
    },
    {
      "id": 13,
      "title": "Outbox rows reclaimed by cleanup",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (rate(outbox_cleanup_deleted_total[1h]))",
          "legendFormat": "{{job}}"
        }
      ],
      "description": "Published rows deleted past outbox.retention (default 7d). Flat at zero on a deployment younger than the retention window; a table that still reclaims nothing after that is a cleanup job that is not running."
    },
    {
      "id": 14,
      "title": "Orders with a stuck saga",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(saga_stuck_count)",
          "legendFormat": "stuck orders"
        }
      ],
      "description": "Orders sitting in a resumable saga state (CREATED, INVENTORY_RESERVATION_PENDING, INVENTORY_RESERVED, PAYMENT_PENDING) past saga.stuck-threshold (ADR 008). Should sit at or near zero: StuckSagaReaper clears each one within a run. A number that stays up means sagas are stalling faster than the reaper resolves them -- orders holding stock that no other signal on this dashboard would show."
    },
    {
      "id": 15,
      "title": "Stuck-saga reaper outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(saga_reaper_retried_total[15m])",
          "legendFormat": "retried"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(saga_reaper_failed_total[15m])",
          "legendFormat": "given up on"
        }
      ],
      "description": "Sagas the reaper restarted versus ones it abandoned after saga.max-attempts (ADR 008). Retries are the system healing itself and a low rate is unremarkable; anything on the 'given up on' series is an order that was compensated and marked FAILED, which is a customer-visible outcome and worth alerting on."
    }
  ]
}
